# Spotify Developer Credentials Configuration
# -------------------------------------------------------------
# 1. Visit: https://developer.spotify.com/dashboard
# 2. Log in and click "Create App"
# 3. Enter any App Name (e.g. "My Lyrics Wallpapers")
# 4. In App Settings -> Redirect URIs, add:
#    http://127.0.0.1:8888/callback
# 5. Copy your Client ID and Client Secret below.
# 6. Copy this file to `.env.spotify` or `.env`:
#    cp .env.example .env.spotify
# -------------------------------------------------------------

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
